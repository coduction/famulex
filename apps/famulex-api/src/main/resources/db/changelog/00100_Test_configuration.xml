<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.6.xsd">

    <changeSet id="00100 - Test configuration" author="Alexander Boeckle">
        <createTable tableName="fx_test_configuration">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="key" type="uuid">
                <constraints nullable="false" unique="true"/>
            </column>

            <column name="created_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
            <column name="deleted_at" type="timestamp with time zone"/>
            <column name="archived_at" type="timestamp with time zone"/>

            <!-- Determines whether this configuration is referenced in a test draft or in an effective test -->
            <!-- COURSE_DRAFT or COURSE -->
            <column name="type" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="fk_course_draft" type="bigint">
                <constraints foreignKeyName="fk_course_draft" references="fx_course_draft(id)"/>
            </column>
            <column name="fk_course_draft_item" type="bigint">
                <constraints foreignKeyName="fk_course_draft_item" references="fx_course_draft_item(id)"/>
            </column>
            <column name="fk_course" type="bigint">
                <constraints foreignKeyName="fk_course" references="fx_course(id)"/>
            </column>
            <column name="fk_course_item" type="bigint">
                <constraints foreignKeyName="fk_course_item" references="fx_course_item(id)"/>
            </column>

            <column name="fk_test" type="bigint">
                <constraints foreignKeyName="fk_test" references="fx_test(id)" nullable="false"/>
            </column>
            <column name="valid_from" type="timestamp with time zone"/>
            <column name="valid_until" type="timestamp with time zone"/>
            <column name="result_from" type="timestamp with time zone"/>
            <column name="result_until" type="timestamp with time zone"/>
            <column name="repeatable" type="boolean">
                <constraints nullable="false"/>
            </column>
            <column name="max_attempts" type="int"/>

            <!-- The following are the effective config values used from the templates given by the test -->
            <column name="points_to_pass" type="double"/>
            <column name="percentage_to_pass" type="double"/>
            <column name="execution_mode" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="duration" type="int"/>
            <column name="shown_questions" type="int"/>
            <column name="shuffle_questions" type="boolean">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="00100 - Tag DB" author="Alexander Boeckle">
        <tagDatabase tag="00100"/>
    </changeSet>
</databaseChangeLog>
