{
  "name": "web-shared-wizard",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/web/shared/wizard/src",
  "prefix": "wizard",
  "tags": ["type:util", "scope:shared"],
  "projectType": "library",
  "targets": {
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "libs/web/shared/wizard/jest.config.ts"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": [
          "libs/web/shared/wizard/**/*.ts",
          "libs/web/shared/wizard/**/*.html"
        ]
      }
    }
  }
}
