<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.6.xsd">
    <changeSet id="00150 - File access" author="Alexander Boeckle">
        <createTable tableName="fx_file_access">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="key" type="uuid">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="created_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
            <column name="valid_until" type="timestamp with time zone"/>
            <column name="usage_count" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="fk_file_permission" type="bigint">
                <constraints foreignKeyName="fk_file_permission" references="fx_file_permission(id)"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="00150 - Tag DB" author="Alexander Boeckle">
        <tagDatabase tag="00150"/>
    </changeSet>
</databaseChangeLog>
