{
  "name": "famulex-ui-web",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "famulex",
  "sourceRoot": "apps/famulex-ui-web/src",
  "tags": [],
  "i18n": {
    "sourceLocale": {
      "code": "en-US",
      "baseHref": "/en/"
    },
    "locales": {
      "de": {
        "translation": "apps/famulex-ui-web/src/i18n/translation.de.xlf",
        "baseHref": "/de/"
      },
      "fr": {
        "translation": "apps/famulex-ui-web/src/i18n/translation.fr.xlf",
        "baseHref": "/fr/"
      },
      "es": {
        "translation": "apps/famulex-ui-web/src/i18n/translation.es.xlf",
        "baseHref": "/es/"
      },
      "sr": {
        "translation": "apps/famulex-ui-web/src/i18n/translation.sr.xlf",
        "baseHref": "/sr-cyr/"
      },
      "sr-Latn": {
        "translation": "apps/famulex-ui-web/src/i18n/translation.sr-Latn.xlf",
        "baseHref": "/sr/"
      }
    }
  },
  "targets": {
    "build": {
      "executor": "@angular-devkit/build-angular:browser",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "outputPath": "dist/apps/famulex-ui-web",
        "index": "apps/famulex-ui-web/src/index.html",
        "main": "apps/famulex-ui-web/src/main.ts",
        "polyfills": [
          "zone.js"
        ],
        "tsConfig": "apps/famulex-ui-web/tsconfig.app.json",
        "allowedCommonJsDependencies": [
          "base64-js",
          "js-sha256"
        ],
        "assets": [
          "apps/famulex-ui-web/src/favicon.ico",
          "apps/famulex-ui-web/src/assets"
        ],
        "styles": [
          "apps/famulex-ui-web/src/styles.scss",
          "libs/shared/layout/src/styles/apollo/apollo.scss",
          {
            "input": "libs/shared/layout/src/styles/apollo/theme/theme-light/blue/theme.scss",
            "bundleName": "theme-light-blue",
            "inject": false
          },
          {
            "input": "libs/shared/layout/src/styles/apollo/theme/theme-light/cyan/theme.scss",
            "bundleName": "theme-light-cyan",
            "inject": false
          },
          {
            "input": "libs/shared/layout/src/styles/apollo/theme/theme-light/green/theme.scss",
            "bundleName": "theme-light-green",
            "inject": false
          },
          {
            "input": "libs/shared/layout/src/styles/apollo/theme/theme-light/indigo/theme.scss",
            "bundleName": "theme-light-indigo",
            "inject": false
          },
          {
            "input": "libs/shared/layout/src/styles/apollo/theme/theme-light/orange/theme.scss",
            "bundleName": "theme-light-orange",
            "inject": false
          },
          {
            "input": "libs/shared/layout/src/styles/apollo/theme/theme-light/pink/theme.scss",
            "bundleName": "theme-light-pink",
            "inject": false
          },
          {
            "input": "libs/shared/layout/src/styles/apollo/theme/theme-light/purple/theme.scss",
            "bundleName": "theme-light-purple",
            "inject": false
          },
          {
            "input": "libs/shared/layout/src/styles/apollo/theme/theme-light/teal/theme.scss",
            "bundleName": "theme-light-teal",
            "inject": false
          },
          {
            "input": "libs/shared/layout/src/styles/apollo/theme/theme-light/red/theme.scss",
            "bundleName": "theme-light-red",
            "inject": false
          },
          {
            "input": "libs/shared/layout/src/styles/apollo/theme/theme-dark/blue/theme.scss",
            "bundleName": "theme-dark-blue",
            "inject": false
          },
          {
            "input": "libs/shared/layout/src/styles/apollo/theme/theme-dark/cyan/theme.scss",
            "bundleName": "theme-dark-cyan",
            "inject": false
          },
          {
            "input": "libs/shared/layout/src/styles/apollo/theme/theme-dark/green/theme.scss",
            "bundleName": "theme-dark-green",
            "inject": false
          },
          {
            "input": "libs/shared/layout/src/styles/apollo/theme/theme-dark/indigo/theme.scss",
            "bundleName": "theme-dark-indigo",
            "inject": false
          },
          {
            "input": "libs/shared/layout/src/styles/apollo/theme/theme-dark/orange/theme.scss",
            "bundleName": "theme-dark-orange",
            "inject": false
          },
          {
            "input": "libs/shared/layout/src/styles/apollo/theme/theme-dark/red/theme.scss",
            "bundleName": "theme-dark-red",
            "inject": false
          },
          {
            "input": "libs/shared/layout/src/styles/apollo/theme/theme-dark/purple/theme.scss",
            "bundleName": "theme-dark-purple",
            "inject": false
          },
          {
            "input": "libs/shared/layout/src/styles/apollo/theme/theme-dark/teal/theme.scss",
            "bundleName": "theme-dark-teal",
            "inject": false
          },
          {
            "input": "libs/shared/layout/src/styles/apollo/theme/theme-dim/blue/theme.scss",
            "bundleName": "theme-dim-blue",
            "inject": false
          },
          {
            "input": "libs/shared/layout/src/styles/apollo/theme/theme-dim/cyan/theme.scss",
            "bundleName": "theme-dim-cyan",
            "inject": false
          },
          {
            "input": "libs/shared/layout/src/styles/apollo/theme/theme-dim/green/theme.scss",
            "bundleName": "theme-dim-green",
            "inject": false
          },
          {
            "input": "libs/shared/layout/src/styles/apollo/theme/theme-dim/indigo/theme.scss",
            "bundleName": "theme-dim-indigo",
            "inject": false
          },
          {
            "input": "libs/shared/layout/src/styles/apollo/theme/theme-dim/orange/theme.scss",
            "bundleName": "theme-dim-orange",
            "inject": false
          },
          {
            "input": "libs/shared/layout/src/styles/apollo/theme/theme-dim/red/theme.scss",
            "bundleName": "theme-dim-red",
            "inject": false
          },
          {
            "input": "libs/shared/layout/src/styles/apollo/theme/theme-dim/purple/theme.scss",
            "bundleName": "theme-dim-purple",
            "inject": false
          },
          {
            "input": "libs/shared/layout/src/styles/apollo/theme/theme-dim/teal/theme.scss",
            "bundleName": "theme-dim-teal",
            "inject": false
          },
          {
            "input": "libs/shared/layout/src/styles/apollo/layout/preloading.scss",
            "bundleName": "preloading",
            "inject": false
          }
        ],
        "scripts": []
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "2kb",
              "maximumError": "4kb"
            }
          ],
          "outputHashing": "all",
          "localize": true
        },
        "development": {
          "buildOptimizer": false,
          "optimization": false,
          "vendorChunk": true,
          "extractLicenses": false,
          "sourceMap": true,
          "namedChunks": true,
          "fileReplacements": [
            {
              "replace": "apps/famulex-ui-web/src/environments/environment.ts",
              "with": "apps/famulex-ui-web/src/environments/environment.development.ts"
            }
          ]
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "executor": "@angular-devkit/build-angular:dev-server",
      "configurations": {
        "production": {
          "browserTarget": "famulex-ui-web:build:production"
        },
        "development": {
          "browserTarget": "famulex-ui-web:build:development"
        }
      },
      "defaultConfiguration": "development"
    },
    "extract-i18n": {
      "executor": "ng-extract-i18n-merge:ng-extract-i18n-merge",
      "options": {
        "browserTarget": "famulex-ui-web:build",
        "format": "xlf2",
        "outputPath": "apps/famulex-ui-web/src/i18n",
        "sourceFile": "translation.en-US.xlf",
        "targetFiles": [
          "translation.de.xlf",
          "translation.es.xlf",
          "translation.fr.xlf",
          "translation.sr.xlf",
          "translation.sr-Latn.xlf",
          "translation.e2e.xlf"
        ]
      }
    },
    "lint": {
      "executor": "@nx/linter:eslint",
      "outputs": [
        "{options.outputFile}"
      ],
      "options": {
        "lintFilePatterns": [
          "apps/famulex-ui-web/**/*.ts",
          "apps/famulex-ui-web/**/*.html"
        ]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": [
        "{workspaceRoot}/coverage/{projectRoot}"
      ],
      "options": {
        "jestConfig": "apps/famulex-ui-web/jest.config.ts",
        "passWithNoTests": true
      },
      "configurations": {
        "ci": {
          "ci": true,
          "codeCoverage": true
        }
      }
    },
    "serve-static": {
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "famulex-ui-web:build"
      }
    },
    "build-image": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "^build"
      ],
      "options": {
        "commands": [
          "docker build apps/famulex-ui-web/deployment -t ghcr.io/coduction/famulex/ui-web:latest"
        ]
      },
      "configurations": {
        "ci": {
          "commands": [
            "docker buildx build -f apps/famulex-ui-web/deployment/Dockerfile -t ghcr.io/coduction/famulex/ui-web:latest --platform linux/amd64 --load .",
            "docker tag ghcr.io/coduction/famulex/ui-web:latest ghcr.io/coduction/famulex/ui-web:main",
            "docker tag ghcr.io/coduction/famulex/ui-web:latest ghcr.io/coduction/famulex/ui-web:$IMAGE_SHA",
            "docker push ghcr.io/coduction/famulex/ui-web:$IMAGE_SHA",
            "docker push ghcr.io/coduction/famulex/ui-web:main",
            "docker push ghcr.io/coduction/famulex/ui-web:latest"
          ],
          "parallel": false
        }
      }
    }
  }
}
