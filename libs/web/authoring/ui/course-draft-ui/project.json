{
  "name": "web-authoring-ui-course-draft-ui",
  "$schema": "../../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/web/authoring/ui/course-draft-ui/src",
  "prefix": "authoring",
  "tags": [
    "type:ui"
  ],
  "projectType": "library",
  "targets": {
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": [
        "{workspaceRoot}/coverage/{projectRoot}"
      ],
      "options": {
        "jestConfig": "libs/web/authoring/ui/course-draft-ui/jest.config.ts",
        "passWithNoTests": true
      },
      "configurations": {
        "ci": {
          "ci": true,
          "codeCoverage": true
        }
      }
    },
    "lint": {
      "executor": "@nx/linter:eslint",
      "outputs": [
        "{options.outputFile}"
      ],
      "options": {
        "lintFilePatterns": [
          "libs/web/authoring/ui/course-draft-ui/**/*.ts",
          "libs/web/authoring/ui/course-draft-ui/**/*.html"
        ]
      }
    }
  }
}
