<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.6.xsd">

    <changeSet id="00050 - Course" author="Alexander Boeckle">
        <createTable tableName="fx_course">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="key" type="uuid">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="created_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
            <column name="fk_course_draft" type="bigint">
                <constraints foreignKeyName="fk_course_draft" references="fx_course_draft(id)"/>
            </column>
            <column name="title" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="text"/>
            <column name="author" type="text"/>
        </createTable>
    </changeSet>

    <changeSet id="00050 - Course translation" author="Alexander Boeckle">
        <createTable tableName="fx_course_i18n">
            <column name="fk_course" type="bigint">
                <constraints primaryKey="true" primaryKeyName="pk_course_i18n" nullable="false"
                             foreignKeyName="fk_course" references="fx_course(id)"/>
            </column>
            <column name="language" type="text">
                <constraints primaryKey="true" primaryKeyName="pk_course_i18n" nullable="false"/>
            </column>
            <column name="created_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
            <column name="title" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="text"/>
        </createTable>
    </changeSet>

    <changeSet id="00050 - Course node" author="Alexander Boeckle">
        <createTable tableName="fx_course_node">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="key" type="uuid">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="created_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
            <column name="fk_course_draft_node" type="bigint">
                <constraints foreignKeyName="fk_course_draft_node" references="fx_course_draft_node(id)"/>
            </column>
            <column name="fk_course" type="bigint">
                <constraints nullable="false" foreignKeyName="fk_course" references="fx_course(id)"/>
            </column>
            <column name="fk_parent" type="bigint">
                <constraints nullable="true" foreignKeyName="fk_parent" references="fx_course_node(id)"/>
            </column>
            <column name="type" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="position" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="title" type="text"/>
            <column name="description" type="text"/>
            <column name="estimated_time" type="int"/>
        </createTable>
    </changeSet>

    <changeSet id="00050 - Course node translation" author="Alexander Boeckle">
        <createTable tableName="fx_course_node_i18n">
            <column name="fk_course_node" type="bigint">
                <constraints primaryKey="true" primaryKeyName="pk_course_node_i18n" nullable="false"
                             foreignKeyName="fk_course_node"
                             references="fx_course_node(id)"/>
            </column>
            <column name="language" type="text">
                <constraints primaryKey="true" primaryKeyName="pk_course_node_i18n" nullable="false"/>
            </column>
            <column name="created_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
            <column name="title" type="text"/>
            <column name="description" type="text"/>
        </createTable>
    </changeSet>

    <changeSet id="00050 - Course node item" author="Alexander Boeckle">
        <createTable tableName="fx_course_item">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="key" type="uuid">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="created_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
            <column name="fk_course_draft_item" type="bigint">
                <constraints foreignKeyName="fk_course_draft_item" references="fx_course_draft_item(id)"/>
            </column>
            <column name="fk_course_node" type="bigint">
                <constraints nullable="false" foreignKeyName="fk_course_node" references="fx_course_node(id)"/>
            </column>
            <column name="type" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="position" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="content" type="text">
                <constraints nullable="true"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="00050 - Course node item translation" author="Alexander Boeckle">
        <createTable tableName="fx_course_item_i18n">
            <column name="fk_course_item" type="bigint">
                <constraints primaryKey="true" primaryKeyName="pk_course_item_i18n" nullable="false"
                             foreignKeyName="fk_course_item"
                             references="fx_course_item(id)"/>
            </column>
            <column name="language" type="text">
                <constraints primaryKey="true" primaryKeyName="pk_course_item_i18n" nullable="false"/>
            </column>
            <column name="created_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
            <column name="content" type="text"/>
        </createTable>
    </changeSet>

    <changeSet id="00050 - Course membership" author="Alexander Boeckle">
        <createTable tableName="fx_course_membership">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="key" type="uuid">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="created_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
            <column name="deleted_at" type="timestamp with time zone"/>
            <column name="valid_from" type="timestamp with time zone"/>
            <column name="valid_until" type="timestamp with time zone"/>
            <column name="type" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="role" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="fk_last_course_node" type="bigint">
                <constraints foreignKeyName="fk_last_course_node" references="fx_course_node(id)"/>
            </column>
            <column name="fk_course" type="bigint">
                <constraints foreignKeyName="fk_course" references="fx_course(id)"/>
            </column>
            <column name="fk_course_draft" type="bigint">
                <constraints foreignKeyName="fk_course_draft" references="fx_course_draft(id)"/>
            </column>
            <column name="fk_user" type="bigint">
                <constraints foreignKeyName="fk_user" references="fx_user(id)"/>
            </column>
            <column name="fk_group" type="bigint">
                <constraints foreignKeyName="fk_group" references="fx_group(id)"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet author="Alexander Boeckle" id="00050 - Tag DB">
        <tagDatabase tag="00050"/>
    </changeSet>
</databaseChangeLog>
