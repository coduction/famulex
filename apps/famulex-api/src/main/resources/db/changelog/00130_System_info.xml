<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.6.xsd">
    <changeSet id="00130 - System info" author="Alexander Boeckle">
        <createTable tableName="fx_system_info">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="key" type="uuid">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="created_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
            <column name="fk_logo_permission" type="bigint">
                <constraints foreignKeyName="fk_logo_permission" references="fx_file_permission(id)"/>
            </column>
            <column name="fk_compact_logo_permission" type="bigint">
                <constraints foreignKeyName="fk_compact_logo_permission" references="fx_file_permission(id)"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="00130 - Tag DB" author="Alexander Boeckle">
        <tagDatabase tag="00130"/>
    </changeSet>
</databaseChangeLog>
